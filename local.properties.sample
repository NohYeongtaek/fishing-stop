## local.properties는 사람마다/기기마다 값이 달라서 git에 커밋하지 않는다(.gitignore 처리됨).
# 이 파일을 복사해서 프로젝트 루트에 local.properties로 저장한 뒤 값을 채워 넣을 것.
#   cp local.properties.sample local.properties

# Android SDK 설치 경로. 보통 Android Studio에서 프로젝트를 한 번 열면 자동으로 채워지지만,
# 커맨드라인(./gradlew)으로 먼저 빌드하는 경우 직접 채워야 한다.
# 예) macOS: /Users/본인계정/Library/Android/sdk
#     Windows: C:\\Users\\본인계정\\AppData\\Local\\Android\\Sdk
sdk.dir=

# Google Safe Browsing v4 API 키(URL 평판 조회, 링크 검사 1차 관문).
# 발급 방법: https://console.cloud.google.com 에서 프로젝트 선택 → "API 및 서비스 → 라이브러리"에서
# "Safe Browsing API" 활성화 → "사용자 인증 정보"에서 API 키 생성.
# 비워두면 앱이 이 단계를 건너뛰고 바로 2차(AI 방문 분석)로 넘어가므로, 당장 없어도 빌드/실행은 된다.
SAFE_BROWSING_API_KEY=
