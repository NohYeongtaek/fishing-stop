<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AI 분석 결과 전송 및 URL 검사 등 네트워크 통신용 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 직접검사 탭의 QR 코드 촬영용. READ_SMS/화면캡처 권한은 사용하지 않음(정책상 제외). -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- 카메라가 없는 기기에서도 설치 가능하도록 required=false -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fishingstop">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Fishingstop.Starting">
            <!-- 앱 런처 아이콘 진입 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 메시지 앱 등에서 "공유(ACTION_SEND)"로 텍스트를 넘겨받는 진입점 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 스크린샷 등 이미지를 "공유"로 넘겨받는 진입점 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
