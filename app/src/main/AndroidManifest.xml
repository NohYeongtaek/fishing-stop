<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AI 분석 결과 전송 및 URL 검사 등 네트워크 통신용 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 직접검사 탭의 QR 코드 촬영용. READ_SMS/화면캡처 권한은 사용하지 않음(정책상 제외). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- FCM 공지사항 알림 표시용(API 33+에서는 런타임 동의 필요) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 카메라가 없는 기기에서도 설치 가능하도록 required=false -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fishingstop">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Fishingstop.Starting">
            <!-- 앱 런처 아이콘 진입 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 메시지 앱 등에서 "공유(ACTION_SEND)"로 텍스트를 넘겨받는 진입점 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 스크린샷 등 이미지를 "공유"로 넘겨받는 진입점 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 로그인이 없어 기기별 토큰을 저장하지 않고, 토픽 구독(전체 공지)만으로 알림을 받는다. -->
        <service
            android:name=".core.fcm.FishingStopFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- notification 페이로드에 채널 지정이 없을 때 사용할 기본 채널(콘솔에서 간단히 보낼 때 대비). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/fcm_notice_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
    </application>

</manifest>
